# ============================================
# USMON SHASHLIK - Environment Variables Example
# ============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/usmon_shashlik?schema=public"

# Telegram Bot Token (BotFather'dan oling)
TELEGRAM_BOT_TOKEN=

# JWT Secret (o'zgartiring!)
JWT_SECRET=

# Server Port
BACKEND_PORT=5000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ngrok URL (Telegram Mini App uchun)
NGROK_URL=

# Default Admin credentials (seed uchun)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
